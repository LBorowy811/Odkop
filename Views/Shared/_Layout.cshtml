<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Odkop</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <a asp-controller="Forum" asp-action="Index">Strona główna</a> |

            @if (Context.Session.GetString("User") != null)
            {
                <span>Witaj, @Context.Session.GetString("User")!</span>
                <a asp-controller="Account" asp-action="Logout">Wyloguj</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Zaloguj się</a>
                <a asp-controller="Account" asp-action="Register">Zarejestruj</a>
            }
        </nav>
        <hr />
    </header>

    <div class="container">
        @RenderBody()
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
