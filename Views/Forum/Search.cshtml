@{
    ViewData["Title"] = "Wyszukiwanie";
    var forums = ViewBag.Forums as List<Odkop.Models.Forum>;
    var topics = ViewBag.Topics as List<Odkop.Models.Topic>;
    var posts = ViewBag.Posts as List<Odkop.Models.Post>;
}

<h2>Wyszukiwanie</h2>

<div class="card mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="query" class="form-label">Szukana fraza</label>
                    <input type="text" name="query" id="query" value="@ViewBag.Query" class="form-control" placeholder="Wpisz szukaną frazę..." />
                </div>
                <div class="col-md-4">
                    <label for="forumId" class="form-label">Forum</label>
                    <select name="forumId" id="forumId" class="form-select">
                        <option value="">Wszystkie fora</option>
                        @if (forums != null)
                        {
                            @foreach (var forum in forums)
                            {
                                <option value="@forum.Id" selected="@(ViewBag.ForumId != null && (int)ViewBag.ForumId == forum.Id)">@forum.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Szukaj</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.Query as string))
{
    <h4>Wyniki wyszukiwania dla: "@ViewBag.Query"</h4>

    var totalResults = (topics?.Count ?? 0) + (posts?.Count ?? 0);

    @if (totalResults > 0)
    {
        <p class="text-muted">Znaleziono @totalResults wyników</p>

        @if (topics != null && topics.Any())
        {
            <h5 class="mt-4 mb-3">Wątki (@topics.Count)</h5>
            @foreach (var topic in topics)
            {
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (topic.IsPinned)
                                {
                                    <span class="badge bg-warning text-dark me-1">Przyklejony</span>
                                }
                                @if (topic.IsLocked)
                                {
                                    <span class="badge bg-secondary me-1">Zamknięty</span>
                                }
                                <a asp-action="Topic" asp-route-id="@topic.Id" class="fw-bold text-decoration-none">
                                    @topic.Title
                                </a>
                                <small class="text-muted ms-2">w @topic.Forum?.Name</small>
                            </div>
                            <div class="text-end">
                                <small class="text-muted">@topic.AuthorName</small>
                                <br />
                                <small class="text-muted">@((topic.LastPostAt ?? topic.Created).ToString("dd.MM.yyyy HH:mm"))</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @if (posts != null && posts.Any())
        {
            <h5 class="mt-4 mb-3">Posty (@posts.Count)</h5>
            @foreach (var post in posts)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <h6 class="card-title">
                            <a asp-action="Topic" asp-route-id="@post.TopicId" class="text-decoration-none">
                                @post.Topic?.Title
                            </a>
                            <small class="text-muted">w @post.Topic?.Forum?.Name</small>
                        </h6>
                        <p class="card-text">@(post.Content.Length > 200 ? post.Content.Substring(0, 200) + "..." : post.Content)</p>
                        <small class="text-muted">@post.AuthorName, @post.Created.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="alert alert-info">Nie znaleziono żadnych wyników.</div>
    }
}
