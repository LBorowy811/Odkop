@model (Odkop.Models.Topic, List<Odkop.Models.Post>)
<!-- Powrot do listy tematow-->
<p>
    <a asp-action="Index" asp-controller="Forum">← Powrót do listy tematów</a>
</p>
<hr />

<h2>@Model.Item1.Title</h2>
<p>Autor: @Model.Item1.Author | Utworzono: @Model.Item1.Created</p>
<!-- Szukanie postów-->
<form asp-action="SearchPosts" method="get">
    <input type="hidden" name="topicId" value="@Model.Item1.Id" />
    <input type="text" name="query" placeholder="Szukaj postów..." value="@ViewBag.Query" />
    <button type="submit">Szukaj</button>
</form>
<hr />
<!-- Wyswieltanie postow-->
<h3>Posty w tym temacie</h3>

@if (Model.Item2.Any())
{
    <ul>
        @foreach (var post in Model.Item2)
        {
            <li>
                <a asp-action="PostDetails" asp-route-id="@post.Id">@post.Title</a>
                - Autor: @post.Author
            </li>
        }
    </ul>
}
else
{
    <p>Brak postów w tym temacie.</p>
}
<!-- Dodawanie posta-->
@if (!string.IsNullOrEmpty(ViewBag.User as string))
{
    <p>
        <a asp-action="CreatePost" asp-route-topicId="@Model.Item1.Id">Dodaj nowy post</a>
    </p>
}
else
{
    <p><a asp-controller="Account" asp-action="Login">Zaloguj się</a>, aby dodać post.</p>
}
