@using Odkop.Controllers
@model IEnumerable<Odkop.Models.Category>
@{
    ViewData["Title"] = "Forum";
    var forumStats = ViewBag.ForumStats as Dictionary<int, ForumStatsViewModel>;
    var totalUsers = ViewBag.TotalUsers;
    var announcements = ViewBag.Announcements as List<Odkop.Models.Announcement>;
}

<div class="row">
    <div class="col-md-9">
        <h1 class="mb-4">Odkop Forum</h1>

        @if (announcements != null && announcements.Any())
        {
            <div class="mb-4">
                @foreach (var announcement in announcements)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <strong>@announcement.Title</strong>
                        <p class="mb-0 mt-1">@announcement.Content</p>
                        <small class="text-muted">@announcement.AuthorName, @announcement.CreatedAt.ToString("dd.MM.yyyy")</small>
                    </div>
                }
            </div>
        }

        @foreach (var category in Model)
        {
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">@category.Name</h5>
                    @if (!string.IsNullOrEmpty(category.Description))
                    {
                        <small>@category.Description</small>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50%">Forum</th>
                                <th class="text-center" style="width: 15%">Wątki</th>
                                <th class="text-center" style="width: 15%">Posty</th>
                                <th style="width: 20%">Opcje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var forum in category.Forums.OrderBy(f => f.DisplayOrder))
                            {
                                var stats = forumStats?.ContainsKey(forum.Id) == true ? forumStats[forum.Id] : null;
                                <tr>
                                    <td>
                                        <a asp-action="Forum" asp-route-id="@forum.Id" class="text-decoration-none fw-bold">
                                            @forum.Name
                                        </a>
                                        @if (!string.IsNullOrEmpty(forum.Description))
                                        {
                                            <br /><small class="text-muted">@forum.Description</small>
                                        }
                                    </td>
                                    <td class="text-center align-middle">
                                        @(stats?.TopicCount ?? 0)
                                    </td>
                                    <td class="text-center align-middle">
                                        @(stats?.PostCount ?? 0)
                                    </td>
                                    <td class="align-middle">
                                        <a asp-action="Forum" asp-route-id="@forum.Id" class="btn btn-sm btn-outline-primary">
                                            Przeglądaj
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                Brak forów. Administrator musi najpierw utworzyć kategorie i fora.
            </div>
        }
    </div>

    <div class="col-md-3">
        <div class="card mb-3">
            <div class="card-header">Statystyki</div>
            <div class="card-body">
                <p class="mb-1"><strong>Użytkownicy:</strong> @totalUsers</p>
                <p class="mb-1"><strong>Fora:</strong> @Model.SelectMany(c => c.Forums).Count()</p>
                <p class="mb-0"><strong>Wątki:</strong> @(forumStats?.Values.Sum(s => s.TopicCount) ?? 0)</p>
            </div>
        </div>

        @if (ViewBag.User == null)
        {
            <div class="card">
                <div class="card-header">Dołącz do nas!</div>
                <div class="card-body">
                    <p>Zarejestruj się, aby móc pisać posty.</p>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary w-100 mb-2">Zarejestruj</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100">Zaloguj</a>
                </div>
            </div>
        }
    </div>
</div>
