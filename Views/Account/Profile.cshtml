@model Odkop.Models.User
@{
    ViewData["Title"] = "Mój profil";
}

<h2>Mój profil</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Nazwa użytkownika:</strong></div>
                    <div class="col-md-8">@Model.Username</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Email:</strong></div>
                    <div class="col-md-8">@Model.Email</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Rola:</strong></div>
                    <div class="col-md-8">
                        <span class="badge @(Model.Role == Odkop.Models.UserRole.Admin ? "bg-danger" : Model.Role == Odkop.Models.UserRole.Moderator ? "bg-warning" : "bg-secondary")">
                            @Model.Role
                        </span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Data rejestracji:</strong></div>
                    <div class="col-md-8">@Model.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Ostatnie logowanie:</strong></div>
                    <div class="col-md-8">@(Model.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Liczba postów:</strong></div>
                    <div class="col-md-8">@Model.PostCount</div>
                </div>

                <hr />

                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="about" class="form-label">O mnie</label>
                        <textarea name="about" id="about" class="form-control" rows="4">@Model.About</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
                </form>
            </div>
        </div>
    </div>
</div>
