@model Odkop.Models.User
@{
    ViewData["Title"] = "Mój profil";
}

<h2>Mój profil</h2>

<div class="row">
    <div class="col-md-3 text-center mb-4">
        <div class="card">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 150px; height: 150px;">
                        <span class="text-white" style="font-size: 48px;">@Model.Username[0].ToString().ToUpper()</span>
                    </div>
                }
                <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <input type="file" name="avatar" class="form-control form-control-sm" accept="image/*" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Zmień zdjęcie</button>
                </form>
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <form asp-action="DeleteAvatar" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Usuń zdjęcie</button>
                    </form>
                }
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Nazwa użytkownika:</strong></div>
                    <div class="col-md-8">@Model.Username</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Email:</strong></div>
                    <div class="col-md-8">@Model.Email</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Rola:</strong></div>
                    <div class="col-md-8">
                        <span class="badge @(Model.Role == Odkop.Models.UserRole.Admin ? "bg-danger" : Model.Role == Odkop.Models.UserRole.Moderator ? "bg-warning" : "bg-secondary")">
                            @Model.Role
                        </span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Data rejestracji:</strong></div>
                    <div class="col-md-8">@Model.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Ostatnie logowanie:</strong></div>
                    <div class="col-md-8">@(Model.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><strong>Liczba postów:</strong></div>
                    <div class="col-md-8">@Model.PostCount</div>
                </div>

                <hr />

                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="about" class="form-label">O mnie</label>
                        <textarea name="about" id="about" class="form-control" rows="4">@Model.About</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
                </form>
            </div>
        </div>
    </div>
</div>
