@model Odkop.Models.User
@{
    ViewData["Title"] = "Profil: " + Model.Username;
}

<h2>Profil użytkownika: @Model.Username</h2>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4"><strong>Nazwa użytkownika:</strong></div>
            <div class="col-md-8">@Model.Username</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4"><strong>Rola:</strong></div>
            <div class="col-md-8">
                <span class="badge @(Model.Role == Odkop.Models.UserRole.Admin ? "bg-danger" : Model.Role == Odkop.Models.UserRole.Moderator ? "bg-warning" : "bg-secondary")">
                    @Model.Role
                </span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4"><strong>Dołączył:</strong></div>
            <div class="col-md-8">@Model.RegisteredAt.ToString("dd.MM.yyyy")</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4"><strong>Liczba postów:</strong></div>
            <div class="col-md-8">@Model.PostCount</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.About))
        {
            <div class="row mb-3">
                <div class="col-md-4"><strong>O mnie:</strong></div>
                <div class="col-md-8">@Model.About</div>
            </div>
        }
    </div>
</div>
