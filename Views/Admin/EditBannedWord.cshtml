@model Odkop.Models.BannedWord
@{
    ViewData["Title"] = "Edytuj zakazane słowo";
}

<h2>Edytuj zakazane słowo</h2>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="EditBannedWord" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Word" class="form-label">Słowo lub fraza</label>
                <input asp-for="Word" class="form-control" />
                <span asp-validation-for="Word" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Reason" class="form-label">Powód (opcjonalnie)</label>
                <input asp-for="Reason" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
            <a asp-action="BannedWords" class="btn btn-secondary">Anuluj</a>
        </form>
    </div>
</div>
