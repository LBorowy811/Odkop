@model Odkop.Models.Category
@{
    ViewData["Title"] = "Nowa kategoria";
}

<h2>Nowa kategoria</h2>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="CreateCategory" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nazwa</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Opis</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label">Kolejność wyświetlania (opcjonalne)</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" value="0" placeholder="0" />
                <small class="text-muted">Domyślnie: 0. Niższe wartości wyświetlane wyżej.</small>
            </div>

            <button type="submit" class="btn btn-primary">Utwórz</button>
            <a asp-action="Categories" class="btn btn-secondary">Anuluj</a>
        </form>
    </div>
</div>
