@model Odkop.Models.Category
@{
    ViewData["Title"] = "Edytuj kategorię";
}

<h2>Edytuj kategorię</h2>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="EditCategory" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nazwa</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Opis</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label">Kolejność wyświetlania</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Zapisz</button>
            <a asp-action="Categories" class="btn btn-secondary">Anuluj</a>
        </form>
    </div>
</div>
