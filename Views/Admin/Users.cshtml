@model IEnumerable<Odkop.Models.User>
@{
    ViewData["Title"] = "Zarządzanie użytkownikami";
}

<h2>Zarządzanie użytkownikami</h2>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary">Powrót</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nazwa</th>
            <th>Email</th>
            <th>Rola</th>
            <th>Rejestracja</th>
            <th>Ostatnie logowanie</th>
            <th>Postów</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>
                    <span class="badge @(user.Role == Odkop.Models.UserRole.Admin ? "bg-danger" : user.Role == Odkop.Models.UserRole.Moderator ? "bg-warning" : "bg-secondary")">
                        @user.Role
                    </span>
                </td>
                <td>@user.RegisteredAt.ToString("dd.MM.yyyy")</td>
                <td>@(user.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                <td>@user.PostCount</td>
                <td>
                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
                    <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Czy na pewno chcesz usunąć tego użytkownika?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
