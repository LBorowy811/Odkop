@model IEnumerable<Odkop.Models.Announcement>
@{
    ViewData["Title"] = "Ogłoszenia";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ogłoszenia</h2>
    <a asp-action="CreateAnnouncement" class="btn btn-primary">Nowe ogłoszenie</a>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Tytuł</th>
                <th>Autor</th>
                <th>Data utworzenia</th>
                <th>Wygasa</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr class="@(!a.IsActive ? "table-secondary" : "")">
                    <td>@a.Title</td>
                    <td>@a.AuthorName</td>
                    <td>@a.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@(a.ExpiresAt?.ToString("dd.MM.yyyy") ?? "-")</td>
                    <td>
                        @if (a.IsActive)
                        {
                            <span class="badge bg-success">Aktywne</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nieaktywne</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditAnnouncement" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Edytuj</a>
                        <form asp-action="ToggleAnnouncement" asp-route-id="@a.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(a.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                @(a.IsActive ? "Dezaktywuj" : "Aktywuj")
                            </button>
                        </form>
                        <form asp-action="DeleteAnnouncement" asp-route-id="@a.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Czy na pewno chcesz usunąć to ogłoszenie?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">
        Brak ogłoszeń. <a asp-action="CreateAnnouncement">Utwórz pierwsze ogłoszenie!</a>
    </div>
}
